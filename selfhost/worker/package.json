{
  "name": "teamspulse-selfhost-worker",
  "private": true,
  "type": "module",
  "description": "Self-host Worker (Cloudflare Workers + D1). Install with: npm install --ignore-scripts",
  "scripts": {
    "dev": "wrangler dev --local-protocol https",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
