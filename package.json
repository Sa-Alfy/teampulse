{
  "name": "teamspulse",
  "version": "0.5.0",
  "description": "Automated academic dashboard and briefing engine for students using Microsoft Teams",
  "main": "teams.js",
  "scripts": {
    "setup": "playwright install chromium",
    "postinstall": "playwright install chromium",
    "login": "node login-teams.js",
    "scrape": "node teams.js",
    "scrape:posts": "node scrape-posts.js",
    "digest": "node build-digest.js",
    "daily": "npm run scrape && npm run digest",
    "server": "node server.js",
    "test": "node --test",
    "start": "node teams.js"
  },
  "keywords": [
    "microsoft-teams",
    "playwright",
    "student-tool",
    "web-scraper",
    "academic-calendar",
    "assignment-tracker"
  ],
  "author": "Shariar Ahamed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sa-Alfy/teampulse.git"
  },
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
